.page {
  min-height: 100vh;
  background: #f8fafc;
  padding-bottom: env(safe-area-inset-bottom);
}

.guest-banner {
  background: #fffbeb;
  padding: 12rpx 28rpx;
  text-align: center;
  font-size: 24rpx;
  color: #f59e0b;
}

.toolbar {
  padding: 20rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #f1f5f9;
}

.search-input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx 0 64rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.filter-row {
  display: flex;
  gap: 16rpx;
}

.picker {
  flex: 1;
}

.picker-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 20rpx;
  background: #f1f5f9;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #1e293b;
}

.arrow {
  font-size: 20rpx;
  color: #94a3b8;
}

.stats-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 28rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 40rpx;
  background: #f1f5f9;
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}

.chip-accent {
  background: #4f46e5;
  color: #fff;
}

.loading-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #94a3b8;
  font-size: 28rpx;
}

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #94a3b8;
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-link {
  display: inline-block;
  margin-top: 16rpx;
  color: #4f46e5;
  font-weight: 600;
  font-size: 28rpx;
}

.item-list {
  padding: 0 28rpx;
}

.item-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  animation: cardIn 0.35s ease both;
}

@keyframes cardIn {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.card-image {
  width: 100%;
  height: 360rpx;
  position: relative;
  overflow: hidden;
  background: #f1f5f9;
}

.card-img {
  width: 100%;
  height: 100%;
}

.image-counter {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 40rpx;
}

.card-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  font-size: 80rpx;
  color: #94a3b8;
}

.card-body {
  padding: 20rpx;
}

.card-title {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  flex: 1;
}

.card-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  white-space: nowrap;
  margin-left: 16rpx;
}

.card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  background: #eef2ff;
  color: #3730a3;
  font-size: 22rpx;
  font-weight: 500;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-待发货 { background: #fef2f2; color: #ef4444; }
.status-已发货 { background: #fffbeb; color: #f59e0b; }
.status-已收货 { background: #ecfdf5; color: #10b981; }
.status-已完成 { background: #eff6ff; color: #3b82f6; }

.meta-text {
  font-size: 24rpx;
  color: #64748b;
}

.card-note {
  background: #f1f5f9;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 20rpx;
  border-top: 1rpx solid #f1f5f9;
  gap: 8rpx;
}

.btn-snap {
  margin-right: auto;
  background: transparent;
  border: none;
  font-size: 28rpx;
  padding: 8rpx 16rpx;
  color: #6b7280;
}

.btn-edit {
  background: transparent;
  border: none;
  color: #4f46e5;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
}

.btn-del {
  background: transparent;
  border: none;
  color: #ef4444;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
}

button::after {
  border: none;
}