<view class="page">
  <view class="form-card">
    <view class="form-row">
      <text class="label">商品名称 *</text>
      <input class="input" placeholder="输入商品名称" value="{{name}}" bindinput="onInput" data-field="name" />
    </view>

    <view class="form-row two-col">
      <view class="col">
        <text class="label">分类</text>
        <picker mode="selector" range="{{categories}}" value="{{categoryIdx}}" bindchange="onCategoryChange">
          <view class="picker-val">{{categories[categoryIdx]}}</view>
        </picker>
      </view>
      <view class="col">
        <text class="label">状态</text>
        <picker mode="selector" range="{{statuses}}" value="{{statusIdx}}" bindchange="onStatusChange">
          <view class="picker-val">{{statuses[statusIdx]}}</view>
        </picker>
      </view>
    </view>

    <view class="form-row two-col">
      <view class="col">
        <text class="label">单价 (¥)</text>
        <input class="input" type="digit" placeholder="0.00" value="{{price}}" bindinput="onInput" data-field="price" />
      </view>
      <view class="col">
        <text class="label">数量</text>
        <input class="input" type="number" placeholder="1" value="{{qty}}" bindinput="onInput" data-field="qty" />
      </view>
    </view>

    <view class="form-row">
      <text class="label">日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="picker-val">{{date || '选择日期'}}</view>
      </picker>
    </view>

    <view class="form-row">
      <text class="label">店铺</text>
      <input class="input" placeholder="店铺名称" value="{{shop}}" bindinput="onInput" data-field="shop" />
    </view>

    <view class="form-row">
      <text class="label">备注</text>
      <textarea class="textarea" placeholder="备注信息" value="{{note}}" bindinput="onInput" data-field="note" />
    </view>

    <view class="form-row">
      <text class="label">商品图片（最多9张）</text>
      <view class="image-section">
        <view class="image-grid">
          <view class="image-item" wx:for="{{images}}" wx:key="*this">
            <image class="thumb" src="{{item}}" mode="aspectFill" bindtap="onPreviewImage" data-idx="{{index}}" />
            <view class="thumb-del" bindtap="onRemoveImage" data-idx="{{index}}">×</view>
          </view>
          <view class="image-item image-add" wx:if="{{images.length < 9}}" bindtap="onChooseImage">
            <text class="add-icon">+</text>
            <text class="add-text">添加图片</text>
          </view>
        </view>
      </view>
    </view>

    <view class="form-actions">
      <button class="btn-cancel" bindtap="onCancel">取消</button>
      <button class="btn-submit" bindtap="onSubmit">{{isEdit ? '保存修改' : '保存到清单'}}</button>
    </view>
  </view>
</view>