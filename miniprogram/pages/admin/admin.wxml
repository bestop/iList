<view class="page">
  <view class="header">
    <text class="title">👥 用户管理</text>
    <text class="count">共 {{users.length}} 人</text>
  </view>

  <view class="loading-state" wx:if="{{loading}}">
    <text>⏳ 加载中...</text>
  </view>

  <view class="empty-state" wx:elif="{{users.length === 0}}">
    <text>暂无用户数据</text>
  </view>

  <view class="user-list" wx:else>
    <view class="user-card" wx:for="{{users}}" wx:key="id">
      <view class="user-info">
        <text class="user-name">{{item.username}}</text>
        <view class="user-meta">
          <text class="role-badge role-{{item.role}}">{{item.role === 'admin' ? '管理员' : '用户'}}</text>
          <text class="user-count">{{item.item_count || 0}} 件商品</text>
          <text class="user-date">{{item.created_at_formatted}}</text>
        </view>
      </view>
      <view class="user-actions" wx:if="{{item.id !== currentUserId}}">
        <button class="btn-sm btn-toggle" bindtap="onToggleRole" data-id="{{item.id}}" data-role="{{item.role}}">
          {{item.role === 'admin' ? '降为用户' : '升为管理员'}}
        </button>
        <button class="btn-sm btn-delete" bindtap="onDeleteUser" data-id="{{item.id}}" data-name="{{item.username}}">
          删除
        </button>
      </view>
      <view class="user-actions" wx:else>
        <text class="self-label">当前用户</text>
      </view>
    </view>
  </view>
</view>