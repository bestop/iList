.page {
  min-height: 100vh;
  background: #f8fafc;
  padding: 24rpx 28rpx;
  padding-bottom: 120rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.count {
  font-size: 24rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 8rpx 20rpx;
  border-radius: 40rpx;
}

.loading-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #94a3b8;
  font-size: 28rpx;
}

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #94a3b8;
  font-size: 28rpx;
}

.user-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.user-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
  margin-bottom: 8rpx;
}

.user-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: #64748b;
}

.role-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.role-admin {
  background: #eef2ff;
  color: #3730a3;
}

.role-user {
  background: #f1f5f9;
  color: #64748b;
}

.user-count {
  color: #64748b;
}

.user-date {
  color: #94a3b8;
}

.user-actions {
  display: flex;
  gap: 12rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.btn-sm {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  border: 1rpx solid #e2e8f0;
  background: #fff;
  color: #64748b;
  line-height: 1.5;
}

.btn-toggle {
  color: #4f46e5;
  border-color: #4f46e5;
}

.btn-delete {
  color: #ef4444;
  border-color: #ef4444;
}

.self-label {
  font-size: 24rpx;
  color: #94a3b8;
  font-style: italic;
}

button::after {
  border: none;
}